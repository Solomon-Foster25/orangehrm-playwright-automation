{
  "name": "orangehrm-playwright-automation",
  "version": "1.0.0",
  "description": "End-to-end and API test automation for the OrangeHRM open-source demo, built with Playwright and TypeScript.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "e2e",
    "api-testing",
    "page-object-model",
    "orangehrm"
  ],
  "author": "Solomon-Foster25",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.0",
    "typescript": "^6.0.3"
  }
}
